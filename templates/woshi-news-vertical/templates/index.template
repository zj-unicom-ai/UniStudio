<!doctype html>
<html lang="zh-CN" data-resolution="portrait">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1080, height=1920" />
  <script src="assets/vendor/gsap.min.js"></script>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: #000D1B; }
    body { font-family: system-ui, -apple-system, sans-serif; color: #F4F6FA; }
    #root { position: relative; width: 1080px; height: 1920px; overflow: hidden; background: #000D1B; }
    #reference-background.clip, #ambient.clip { position: absolute; inset: 0; width: 1080px; height: 1920px; pointer-events: none; }
    #reference-background.clip { object-fit: fill; }
    #reference-wave-flow.clip { position: absolute; inset: 0; width: 1080px; height: 1920px; background-size: 1080px 1920px; background-position: center; pointer-events: none; transform-origin: 50% 98%; mask-image: linear-gradient(to bottom,transparent 0 84%,#000 90% 100%); }
    .brand-row.clip { position: absolute; left: 82px; top: 106px; width: 925px; height: 60px; }
    #brand-inner { display: flex; align-items: center; justify-content: space-between; width: 100%; }
    .brand { display: flex; align-items: center; gap: 28px; color: #F4F6FA; font-size: 42px; font-weight: 520; font-style: italic; letter-spacing: 4px; }
    .brand-mark { display: inline-flex; align-items: center; height: 51px; }
    .brand-mark i { display: block; width: 20px; height: 51px; background: #00DDEB; transform: skew(-22deg); }
    .publish-date { position: absolute; right: 0; top: -10px; padding: 0 9px; color: #F4F6FA; background: rgba(0,11,24,.55); font-size: 29px; font-weight: 450; font-style: italic; letter-spacing: 1.5px; font-variant-numeric: tabular-nums; }
    .headline.clip { position: absolute; left: 76px; top: 213px; width: 936px; height: 130px; margin: 0; font-size: 94px; line-height: 1.1; font-weight: 900; font-style: italic; letter-spacing: -1.7px; }
    #headline-inner, #subtitle-inner { display: block; width: 100%; }
    #headline-inner { white-space: nowrap; }
    .title-line { display: inline; white-space: nowrap; }
    .title-line + .title-line { margin-left: 16px; }
    .headline.is-multiline { top: 175px; height: 230px; }
    .headline.is-multiline .title-line { display: block; margin-left: 0; }
    .accent { color: #00D9E8; }
    .subtitle.clip { position: absolute; left: 78px; top: 354px; width: 929px; height: 85px; color: #F1F4FA; font-size: 62px; line-height: 1.22; font-weight: 730; font-style: italic; letter-spacing: -.5px; white-space: nowrap; }
    .cyan-rule { position: absolute; left: 74px; top: 455px; width: 115px; height: 6px; background: linear-gradient(90deg,#00E6ED 0 58%,#009BC9 58%); }
    #hero-frame { position: absolute; inset: 500px 0 auto; width: 1080px; height: 804px; overflow: hidden; background: #07192D; }
    .hero-scene.clip { position: absolute; inset: 0; width: 1080px; height: 804px; object-fit: cover; transform-origin: 50% 50%; }
    /* Registry page-slide + shimmer-sweep, adapted to the 1080×804 news window. */
    #hero-scan.clip { position: absolute; inset: 0; width: 1080px; height: 804px; z-index: 3; pointer-events: none; }
    #hero-scan .shimmer-mask { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; --shimmer-pos: -20%; background: linear-gradient(112deg,rgba(0,221,235,0) 0%,rgba(0,221,235,0) calc(var(--shimmer-pos) - 12%),rgba(0,221,235,.55) calc(var(--shimmer-pos) - 1%),rgba(221,255,255,.85) var(--shimmer-pos),rgba(0,155,255,.24) calc(var(--shimmer-pos) + 5%),rgba(0,155,255,0) calc(var(--shimmer-pos) + 12%),rgba(0,155,255,0) 100%); }
    .hero-vignette { position: absolute; inset: 0; pointer-events: none; background: rgba(0,13,26,.05); }
    .illustration-label { position: absolute; z-index: 5; top: 38px; right: 76px; padding: 10px 14px; color: #C4D5E0; font-size: 21px; font-weight: 560; letter-spacing: 1px; border: 1px solid rgba(170,203,220,.3); background: rgba(0,12,24,.65); }
    .summary-scene.clip { position: absolute; left: 79px; top: 1405px; width: 926px; min-height: 240px; }
    .summary-text { margin: 0; color: #F4F6FA; font-size: 43px; line-height: 1.53; font-weight: 400; letter-spacing: .8px; max-width: 926px; }
    #ambient .wave-line, #ambient .wave-glow, #ambient .wave-reflection { fill: none; stroke-linecap: round; }
    .clip { backface-visibility: hidden; }
  </style>
</head>
<body>
  <main id="root" data-composition-id="main" data-start="0" data-duration="{{DURATION}}" data-width="1080" data-height="1920" data-fps="30">
    {{REFERENCE_BACKGROUND}}
    {{REFERENCE_WAVE_TEXTURE}}
    <div id="brand-row" class="brand-row clip" data-start="0" data-duration="{{DURATION}}" data-track-index="0">
      <span id="brand-inner"><span class="brand"><span class="brand-mark" aria-hidden="true"><i></i></span><span>{{BRAND}}</span></span><span class="publish-date">{{DATE}}</span></span>
    </div>
    <h1 id="headline" class="headline clip {{TITLE_LAYOUT_CLASS}}" style="{{HEADLINE_STYLE}}" data-start="0" data-duration="{{DURATION}}" data-track-index="0"><span id="headline-inner">{{TITLE_LINES}}</span></h1>
    <div id="subtitle" class="subtitle clip" style="{{SUBTITLE_STYLE}}" data-start="0" data-duration="{{DURATION}}" data-track-index="0"><span id="subtitle-inner">{{SUBTITLE}}</span></div>
    <div class="cyan-rule" aria-hidden="true"></div>
    <section id="hero-frame" aria-label="新闻主视觉">
      {{HERO_SCENES}}
      <div class="hero-vignette" aria-hidden="true"></div>
      <div id="hero-scan" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="11" aria-hidden="true"><span class="shimmer-mask"></span></div>
      <div class="illustration-label">原创概念示意图</div>
    </section>
    {{SUMMARY_SCENES}}
    <svg id="ambient" class="clip" data-start="0" data-duration="{{DURATION}}" data-track-index="8" viewBox="0 0 1080 1920" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="wave-spectrum"><stop stop-color="#128AFF"/><stop offset=".24" stop-color="#00E7FF"/><stop offset=".59" stop-color="#00CBFF"/><stop offset=".79" stop-color="#157AF2"/><stop offset="1" stop-color="#B171F3"/></linearGradient>
        <filter id="wave-soft" x="-20%" y="-100%" width="140%" height="300%"><feGaussianBlur stdDeviation="4"/></filter>
        <filter id="particle-soft" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="5"/></filter>
        <filter id="reflection-soft"><feGaussianBlur stdDeviation="1.3"/></filter>
      </defs>
      <g filter="url(#wave-soft)" opacity=".45">{{BAR_GLOWS}}</g>
      <g id="audio-bars">{{AUDIO_BARS}}</g>
      <g transform="translate(0 2342.4) scale(1 -.28)" opacity=".18" filter="url(#reflection-soft)">{{BAR_REFLECTIONS}}</g>
      <!-- Extend decorative paths beyond the canvas so the edge remains filled while flowing. -->
      <g id="wave-glows" data-layout-allow-overflow>{{WAVE_GLOWS}}</g>
      <g id="wave-lines" data-layout-allow-overflow>{{WAVE_PATHS}}</g>
      <g data-layout-allow-overflow transform="translate(0 2435.4) scale(1 -.32)" filter="url(#reflection-soft)">{{WAVE_REFLECTIONS}}</g>
      <g data-layout-allow-overflow opacity=".7">{{PARTICLE_GLOWS}}</g>
      <g id="particles" data-layout-allow-overflow>{{PARTICLES}}</g>
    </svg>
    <audio id="voiceover" data-start="{{AUDIO_START}}" data-duration="{{AUDIO_DURATION}}" preload="auto" src="{{AUDIO_PATH}}"></audio>
  </main>
  <script>
    window.__timelines = window.__timelines || {};
    const ISSUE = {{ISSUE_JSON}};
    const ENVELOPE = {{ENVELOPE_JSON}};
    const DURATION = {{DURATION}};
    const AUDIO_START = {{AUDIO_START}};
    const motion = ISSUE.motion;
    const clock = { t: 0 };
    const tl = gsap.timeline({ paused: true });
    tl.to(clock, { t: DURATION, duration: DURATION, ease: "none" }, 0);
    // Keep the opening frame usable as a complete poster/cover in common video players.
    const scenes = [...document.querySelectorAll(".hero-scene")];
    ISSUE.story.imageTimeline.forEach((entry, index) => {
      const scene = scenes[index];
      const start = entry.startSec;
      const end = ISSUE.story.imageTimeline[index + 1]?.startSec ?? AUDIO_START + ENVELOPE.durationSec;
      const enterAt = index === 0 ? start + .35 : start;
      const enterDuration = index === 0 ? motion.imageEntranceSec : motion.imageTransitionSec;
      // Same-time page handoff: the outgoing image remains visible beneath the incoming one.
      if (index === 0) {
        // The first image is fully visible at t=0, then eases into its reading scale.
        tl.set(scene, { opacity: 1, xPercent: 0, y: 0, scale: 1.08 }, start);
        tl.to(scene, { scale: 1.015, duration: enterDuration, ease: "power3.out" }, enterAt);
      } else {
        tl.fromTo(scene,
          { opacity: 1, xPercent: 100, y: 0, scale: 1.055 },
          { opacity: 1, xPercent: 0, y: 0, scale: 1.015, duration: enterDuration, ease: "power3.inOut" }, enterAt);
      }
      const settleAt = enterAt + enterDuration;
      tl.fromTo(scene, { scale: 1.015 }, { scale: motion.imageScaleTo, duration: Math.max(.3,end - settleAt), ease: "none", immediateRender: false }, settleAt);
      if (index > 0) tl.to(scenes[index - 1], { xPercent: -28, duration: enterDuration, ease: "power3.inOut" }, start);
      const sweepAt = enterAt + (index === 0 ? .16 : 0);
      const sweepDuration = index === 0 ? .6 : enterDuration;
      tl.fromTo("#hero-scan .shimmer-mask", { "--shimmer-pos": "-20%", opacity: .62 }, { "--shimmer-pos": "120%", opacity: .62, duration: sweepDuration, ease: "power2.inOut", immediateRender: false }, sweepAt);
      tl.set("#hero-scan .shimmer-mask", { opacity: 0 }, sweepAt + sweepDuration);
    });
    const summaries = [...document.querySelectorAll(".summary-scene")];
    ISSUE.story.summarySegments.forEach((entry, index) => {
      if (index === 0) tl.set(summaries[index], { opacity: 1, y: 0 }, entry.startSec);
      else tl.fromTo(summaries[index], { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: motion.summaryTransitionSec, ease: "power2.out" }, entry.startSec);
      if (index > 0) tl.to(summaries[index - 1], { opacity: 0, y: -8, duration: motion.summaryTransitionSec, ease: "power1.in" }, entry.startSec);
    });
    const wavePaths = [...document.querySelectorAll("[data-line]")];
    const bars = [...document.querySelectorAll("[data-bar]")];
    const particles = [...document.querySelectorAll("[data-particle]")];
    const bgStars = [...document.querySelectorAll(".bg-star")];
    const beams = [...document.querySelectorAll(".ambient-beam")];
    const waveTexture = document.querySelector("#reference-wave-flow");
    const seed = motion.waveSeed;
    const values = ENVELOPE.values;
    function hash(i) { const v = Math.sin(i * 127.1 + seed * .017) * 43758.5453; return v - Math.floor(v); }
    function envAt(t, offset = 0) {
      const local = t - AUDIO_START;
      if (local < 0 || local > ENVELOPE.durationSec) return .04;
      const index = local / ENVELOPE.sampleIntervalSec + offset;
      const lo = Math.max(0, Math.min(values.length - 1, Math.floor(index)));
      const hi = Math.min(values.length - 1, lo + 1);
      const mix = Math.max(0, Math.min(1, index - lo));
      return values[lo] * (1 - mix) + values[hi] * mix;
    }
    function waveY(x, line, t) {
      const center = 794 + Math.sin(t * .24) * 34;
      const base = 1818 + line * 2.8;
      const left = (72 - line * .35) * Math.exp(-Math.pow(x / 172, 2));
      const crest = (128 - line * 1.9) * Math.exp(-Math.pow((x - center) / (177 + line * 1.1), 2));
      const trough = 22 * Math.exp(-Math.pow((x - 330) / 228, 2));
      return base - left - crest + trough + Math.sin(x * .008 + t * .48 + line * .16) * 3;
    }
    function updateAt(t) {
      wavePaths.forEach(path => {
        const line = Number(path.dataset.line);
        let d = "";
        for (let x = -36; x <= 1116; x += 12) d += `${x === -36 ? "M" : "L"}${x} ${waveY(x, line, t).toFixed(2)} `;
        path.setAttribute("d", d.trim());
      });
      bars.forEach(bar => {
        const i = Number(bar.dataset.bar);
        const x = (i + .5) * (1080 / motion.barCount);
        const audio = envAt(t, ((i % 7) - 3) * .44);
        const shape = 26 + 230 * Math.exp(-Math.pow((x - 594) / 66, 2)) + 84 * Math.exp(-Math.pow((x - 124) / 70, 2)) + 92 * Math.exp(-Math.pow((x - 929) / 58, 2));
        const height = Math.min(220, 8 + shape * (.16 + .84 * audio) * (.63 + hash(i + 20) * .37));
        bar.setAttribute("y", (1818 - height).toFixed(2));
        bar.setAttribute("height", height.toFixed(2));
        bar.setAttribute("opacity", (.32 + audio * .55).toFixed(3));
      });
      particles.forEach(particle => {
        const i = Number(particle.dataset.particle);
        const speed = 4 + hash(i + 6) * 8;
        const x = (hash(i) * 1080 + t * speed) % 1080;
        const band = waveY(x, i % motion.waveLineCount, t);
        const y = band + (i % 3 === 0 ? -hash(i + 31) * 136 : hash(i + 61) * 68 - 26);
        const bright = i % 18 === 0;
        const alpha = (bright ? .48 : .15 + hash(i + 72) * .25) * (.78 + .22 * Math.sin(t * .64 + i * 1.3));
        particle.setAttribute("cx", x.toFixed(2));
        particle.setAttribute("cy", y.toFixed(2));
        particle.setAttribute("opacity", alpha.toFixed(3));
      });
      bgStars.forEach((star, i) => star.setAttribute("opacity", (.83 + Math.sin(t * .48 + i) * .17).toFixed(3)));
      beams.forEach((beam, i) => beam.setAttribute("transform", `translate(${(Math.sin(t * .18 + i) * 7).toFixed(2)} ${(Math.sin(t * .14 + i) * 3).toFixed(2)})`));
      if (waveTexture) waveTexture.style.transform = `translate(${(Math.sin(t * .23) * 6).toFixed(2)}px,${(Math.sin(t * .19) * 2).toFixed(2)}px) scaleX(1.012)`;
    }
    tl.eventCallback("onUpdate", () => updateAt(clock.t));
    window.__timelines["main"] = tl;
    updateAt(0);
    tl.seek(0);
  </script>
</body>
</html>
